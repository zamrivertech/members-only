<h1>Posts</h1>


<% if user_signed_in? %>
<%= link_to "Log Out", destroy_user_session_path, data: { turbo_method: :delete} %>
<% else %>
<%= link_to "Sign In", new_user_session_path%>
<% end %>

<ul>
 <% @posts.each do |post| %>
   <li> 
    <%= post.title %> 
    <br>
    <%= post.body %>    
    <br>
    <% if user_signed_in? %> 
      Written by: <%= post.user.email %>
    <% end %>       
   </li>

 <% end %>
</ul>

<% if user_signed_in? %>
 <a href='/posts/new'>Create new post</a>
<% end %>